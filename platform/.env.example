# =============================================================================
# Social OS — environment
#
# Copy to .env and fill in. Nothing here has a working default: the app refuses
# to start without CREDENTIAL_ENCRYPTION_KEY, and each platform stays
# unconnectable until its own app credentials are present.
# =============================================================================

NODE_ENV=development
PORT=4000
BASE_URL=http://localhost:4000
LOG_LEVEL=info

# --- storage -----------------------------------------------------------------
# Dev/CI: a SQLite file, through node's built-in driver (no dependencies).
DATABASE_FILE=./data/social-os.db
# Production: point at PostgreSQL instead. See docs/ARCHITECTURE.md.
# DATABASE_URL=postgres://user:pass@host:5432/social_os

# --- secrets (required) ------------------------------------------------------
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Every OAuth token is sealed with AES-256-GCM under this key. Rotating it makes
# existing stored tokens unreadable — accounts must be reconnected.
CREDENTIAL_ENCRYPTION_KEY=

SESSION_TTL_MINUTES=10080

# --- AI ----------------------------------------------------------------------
# Leave ANTHROPIC_API_KEY empty to run on the deterministic offline provider:
# every feature works, with heuristic copy instead of model-written copy.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_HEAVY_MODEL=claude-opus-5
AI_MAX_TOKENS=2000
AI_TIMEOUT_MS=60000

# --- platform apps -----------------------------------------------------------
# Each platform is connectable only once its own app credentials are set.
# Quora is absent on purpose: it publishes no write API, so it is always manual.

# Instagram + Facebook (Meta Graph API)
META_APP_ID=
META_APP_SECRET=

# LinkedIn (Marketing Developer Platform)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_VERSION=202409

# X (API v2, OAuth 2.0 PKCE)
X_CLIENT_ID=
X_CLIENT_SECRET=

# Reddit — the user agent must identify your app and a contact account,
# as Reddit's API terms require.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=social-os/0.1 (by /u/your-agency-account)

# Threads
THREADS_APP_ID=
THREADS_APP_SECRET=

# YouTube / Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=

# --- workers and scheduling --------------------------------------------------
WORKER_POLL_MS=2000
WORKER_CONCURRENCY=4
RESEARCH_ENABLED=true
JOB_TREND_INTERVAL_MIN=30
JOB_ENGAGEMENT_INTERVAL_MIN=120
JOB_BRIEF_HOUR_UTC=2

# --- engagement thresholds (§12) ---------------------------------------------
THRESHOLD_RELEVANCE=80
THRESHOLD_BRAND_FIT=75
THRESHOLD_SPAM_RISK=20
THRESHOLD_COMMENT_QUALITY=75

# --- anti-spam ceilings (§43) ------------------------------------------------
# These are OUR limits, deliberately well inside each platform's published rate
# limits. They are ceilings to stay under, not a budget to spend.
LIMIT_COMMENTS_HOUR=4
LIMIT_COMMENTS_DAY=15
LIMIT_POSTS_DAY=6
LIMIT_COMMENT_COOLDOWN_MIN=12
LIMIT_SAME_AUTHOR_COOLDOWN_H=72
LIMIT_SIMILARITY=0.82
LIMIT_API_RPM=120

# --- demo --------------------------------------------------------------------
DEMO_PASSWORD=change-me-please-1234
