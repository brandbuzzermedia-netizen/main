        }
      },
      "id": "fb063065-1181-5f56-a8b2-755eeae1be27",
      "name": "Accept",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const inr = (m) => '₹' + (Number(m || 0) / 100).toLocaleString('en-IN', { maximumFractionDigits: 0 });\nconst s = $('Verify signature').first().json.input;\nconst out = [];\nfor (const i of s.invoices || []) {\n  const when = i.stage === 'pre_due' ? `is due on ${i.due_date}` : i.stage === 'due' ? 'is due today' : `was due on ${i.due_date} (${i.days_overdue} days ago)`;\n  const pay = i.pay_url ? `\\n\\nPay securely here: ${i.pay_url}` : '';\n  for (const to of i.emails || []) out.push({ json: { channel: 'email', to, subject: `${s.company}: invoice ${i.invoice_number} ${i.stage === 'overdue' ? 'is overdue' : 'reminder'}`,\n    text: `Dear ${i.client},\\n\\nInvoice ${i.invoice_number} for ${inr(i.outstanding_minor)} ${when}.${pay}\\n\\nIf you have already paid, please ignore this message.\\n\\n${s.company}` } });\n  for (const to of i.whatsapp || []) out.push({ json: { channel: 'whatsapp', to, template: $env.DP_WA_PAYMENT_TEMPLATE || 'payment_reminder',\n    params: [i.client, i.invoice_number, inr(i.outstanding_minor), i.due_date, i.pay_url || ''] } });\n}\nreturn out;"
      },
