    {
      "parameters": {
        "jsCode": "const s = $('Verify signature').first().json.input;\nreturn [{ json: { subject: `${s.company}: ${s.bills_awaiting_review} bill(s) waiting for review`,\n  text: `${s.bills_awaiting_review} uploaded bill(s) are waiting for a person to check the extracted fields (oldest: ${s.oldest_waiting_days} day(s)).\\nNothing is posted to the ledger until someone reviews and approves it in Finance → Expenses & bills.` } }];\n"
      },
      "id": "dfac3565-2b3d-59e2-964c-191e7bcff197",
      "name": "Compose message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        200
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.DP_FROM_EMAIL }}",
        "toEmail": "={{ $env.DP_OWNER_EMAIL }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "6c22373f-cd42-5a81-a26d-148b6b589c58",
      "name": "Email the owner",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1100,
        200
      ],
