    {
      "parameters": {
        "jsCode": "// Verifies the OS signature: HMAC-SHA256(secret, `${timestamp}.${nonce}.${body}`), max 5 minutes old.\n// Needs NODE_FUNCTION_ALLOW_BUILTIN=crypto and DP_SIGNING_SECRET (same value as N8N_SIGNING_SECRET in the OS).\nconst crypto = require('crypto');\nconst item = $input.first();\nconst h = item.json.headers || {};\nconst secret = $env.DP_SIGNING_SECRET || '';\nconst raw = item.binary && item.binary.data ? Buffer.from(item.binary.data.data, 'base64').toString('utf8') : JSON.stringify(item.json.body);\nconst ts = String(h['x-dp-timestamp'] || ''), nonce = String(h['x-dp-nonce'] || ''), sig = String(h['x-dp-signature'] || '');\nlet ok = Boolean(secret) && /^\\d{9,11}$/.test(ts) && nonce.length >= 16 && nonce.length <= 128 && /^[0-9a-f]{64}$/.test(sig)\n  && Math.abs(Math.floor(Date.now() / 1000) - Number(ts)) <= 300;\nif (ok) {\n  const expected = crypto.createHmac('sha256', secret).update(`${ts}.${nonce}.${raw}`).digest();\n  const given = Buffer.from(sig, 'hex');\n  ok = given.length === expected.length && crypto.timingSafeEqual(given, expected);\n}\nlet payload = {};\ntry { payload = JSON.parse(raw); } catch (e) { ok = false; }\nconst runOk = ok && /^[0-9a-f-]{36}$/.test(String(payload.run_id || '')) && /^[0-9a-f-]{36}$/.test(String(payload.organization_id || ''));\nreturn [{ json: { ok: runOk, run_id: payload.run_id, organization_id: payload.organization_id, input: payload.input || {} } }];\n"
      },
      "id": "86644186-a347-552f-923f-6e8e714f114f",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "ok",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      },
      "id": "16cde70f-2946-50da-9755-299a964e601b",
