    },
    {
      "parameters": {
        "jsCode": "// Signs the result for the OS callback exactly as the OS signs its webhooks.\nconst crypto = require('crypto');\nconst run = $('Verify signature').first().json;\nconst failed = $input.first().json.error;\nconst body = JSON.stringify({\n  run_id: run.run_id,\n  organization_id: run.organization_id,\n  status: failed ? 'failed' : 'succeeded',\n  execution_id: String($execution.id),\n  ...(failed ? { error: String(failed.message || failed).slice(0, 1900) } : {}),\n});\nconst ts = Math.floor(Date.now() / 1000);\nconst nonce = crypto.randomBytes(16).toString('hex');\nconst signature = crypto.createHmac('sha256', $env.DP_SIGNING_SECRET).update(`${ts}.${nonce}.${body}`).digest('hex');\nreturn [{ json: { body, ts: String(ts), nonce, signature } }];\n"
      },
      "id": "dafe8043-d51f-514d-9b19-6a4b38e72ea5",
