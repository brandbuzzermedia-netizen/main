{
  "name": "Diwani Parivaar OS · Incoming WhatsApp (Meta or WATI) → OS",
  "id": "7292116af647521a",
  "versionId": "dbac462a-46fd-5479-ad0a-7a904a2a6bfd",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "dp-whatsapp-incoming",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "f698ad02-d6fb-5a14-9d94-667916ba677f",
      "name": "Incoming",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "8af26de4-81e7-5da4-9720-0d08d40cc4c0"
    },
    {
      "parameters": {
        "jsCode": "// Register …/webhook/dp-whatsapp-incoming?org=<company id>&key=<DP_RELAY_KEY> in Meta (WhatsApp → Configuration) or in WATI (Webhooks, \"Message received\").\nconst q = $('Incoming').first().json.query || {}; const org = q.org; const b = $json.body || {}; const out = [];\nif (!$env.DP_RELAY_KEY || q.key !== $env.DP_RELAY_KEY) return [];\nconst push = (from, name, text) => { if (!from || !text) return;\n  out.push({ json: { payload: { type: 'message', organization_id: org, channel: 'whatsapp', from: '+' + String(from).replace(/\\D/g, ''), ...(name ? { name: String(name).slice(0, 200) } : {}), text: String(text).slice(0, 4000) } } }); };\nfor (const e of b.entry || []) for (const ch of e.changes || []) {   // Meta Cloud API\n  const v = ch.value || {}; const names = Object.fromEntries((v.contacts || []).map((c) => [c.wa_id, c.profile && c.profile.name]));\n  for (const m of v.messages || []) push(m.from, names[m.from], (m.text && m.text.body) || (m.button && m.button.text) || (m.interactive && m.interactive.button_reply && m.interactive.button_reply.title));\n}\nif (b.waId && b.owner !== true && (!b.eventType || b.eventType === 'message')) push(b.waId, b.senderName, b.text);   // WATI\nreturn out;"
      },
      "id": "06addf35-8f82-5441-9b28-854c987ceb4b",
      "name": "Map to OS",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Signs one message for the OS inbound endpoint, exactly as the OS signs its webhooks.\nconst crypto = require('crypto');\nconst body = JSON.stringify($json.payload);\nconst ts = Math.floor(Date.now() / 1000);\nconst nonce = crypto.randomBytes(16).toString('hex');\nconst signature = crypto.createHmac('sha256', $env.DP_SIGNING_SECRET).update(`${ts}.${nonce}.${body}`).digest('hex');\nreturn { json: { body, ts: String(ts), nonce, signature } };\n",
        "mode": "runOnceForEachItem"
      },
      "id": "13d51266-e1b5-5ad6-9d6a-c8f9d6aa9262",
      "name": "Sign for OS",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DP_APP_URL }}/api/inbound",
        "options": {
          "timeout": 20000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            },
            {
              "name": "x-dp-timestamp",
              "value": "={{ $json.ts }}"
            },
            {
              "name": "x-dp-nonce",
              "value": "={{ $json.nonce }}"
            },
            {
              "name": "x-dp-signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}"
      },
      "id": "6d8a9a54-62d1-55c7-a1a1-df6a04a5d947",
