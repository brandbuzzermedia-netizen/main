# Copy to .env.local for development. Never commit real values.
# In production, set these in Vercel → Project → Settings → Environment Variables.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The anon/publishable key is safe in the browser: every table is protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Used only by signed job/webhook routes (Phase 5+). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of this app (used in magic-link redirects).
APP_URL=http://localhost:3000

# Optional comma-separated allowlist of emails that may receive sign-in links.
# Leave empty to rely on Supabase Auth settings (recommended: disable public signups and invite users).
AUTH_ALLOWED_EMAILS=

# --- Swipe ---
# Keep false until a key from Swipe → API Integration has been tested on your plan
# (see docs/SWIPE_INTEGRATION.md). CSV import and manual entry work without it.
SWIPE_API_ENABLED=false
SWIPE_API_KEY=

# --- Later phases (not used yet) ---
# RESEND_API_KEY=
# WHATSAPP_PROVIDER=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# JOBS_HMAC_SECRET=

# --- Razorpay (payment links + webhook) ---
# Start with TEST keys (rzp_test_…) from Dashboard → Account & Settings → API Keys.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type when adding the webhook (Dashboard → Settings → Webhooks). Not the API secret.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_LINK_VALIDITY_DAYS=30

# --- Claude (server-side only; never NEXT_PUBLIC_) ---
# Without a key the AI features run in mock mode: bills are entered by hand and drafting is off.
# Each company must also switch AI on in Settings, with a monthly token budget.
ANTHROPIC_API_KEY=
# AI_MODE=mock

# --- n8n automation ---
# Base URL of your n8n instance (https only) and a long random secret shared with n8n for
# HMAC-signed requests in both directions. Without them, automation runs in mock mode.
N8N_BASE_URL=
N8N_SIGNING_SECRET=
# development | staging | production. Keep separate n8n workflows per environment.
N8N_ENVIRONMENT=development
# N8N_MODE=mock

# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>" to /api/automation/dispatch.
CRON_SECRET=
