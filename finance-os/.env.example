# Copy to .env.local for development. Never commit real values.
# In production, set these in Vercel → Project → Settings → Environment Variables.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The anon/publishable key is safe in the browser: every table is protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Used only by signed job/webhook routes (Phase 5+). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of this app (used in magic-link redirects).
APP_URL=http://localhost:3000

# Optional comma-separated allowlist of emails that may receive sign-in links.
# Leave empty to rely on Supabase Auth settings (recommended: disable public signups and invite users).
AUTH_ALLOWED_EMAILS=

# --- Swipe ---
# Keep false until a key from Swipe → API Integration has been tested on your plan
# (see docs/SWIPE_INTEGRATION.md). CSV import and manual entry work without it.
SWIPE_API_ENABLED=false
SWIPE_API_KEY=

# --- Later phases (not used yet) ---
# RESEND_API_KEY=
# WHATSAPP_PROVIDER=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# JOBS_HMAC_SECRET=
