# ── Required ─────────────────────────────────────────────────────────────
# Postgres / Supabase connection (use the session-mode pooler on Supabase).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gbs_engagement
# 32 random bytes, base64. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Public base URL, used for OAuth redirect URIs.
APP_URL=http://localhost:3000
# Shared secret for /api/cron/* (Authorization: Bearer <secret>).
CRON_SECRET=

# ── AI ──────────────────────────────────────────────────────────────────
# Without a key the app uses the offline draft provider (development only).
ANTHROPIC_API_KEY=
# Optional override; the organisation's AI settings take precedence.
AI_MODEL=claude-opus-5-5
# Optional: Voyage AI embeddings for duplicate detection (otherwise a local embedder is used).
VOYAGE_API_KEY=

# ── Platforms (official APIs only) ──────────────────────────────────────
ENABLED_PLATFORMS=instagram,facebook,linkedin
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202509
# Leave false unless commenting on third-party posts is within your approved LinkedIn product use.
LINKEDIN_ALLOW_THIRD_PARTY_COMMENTS=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Optional ────────────────────────────────────────────────────────────
# Extra origins allowed to call server actions (reverse proxies), comma-separated.
APP_ALLOWED_ORIGINS=
# Run seed data with demo passwords (never in production).
SEED_DEMO_PASSWORD=
