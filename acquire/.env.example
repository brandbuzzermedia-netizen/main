# Copy to .env.local for development. Never commit real values.
# In production, set these in Vercel → Project → Settings → Environment Variables.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# The anon/publishable key is safe in the browser: every table is protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Used only to look up and invite users (Settings → Team).
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of this app (used in sign-in and invite links).
APP_URL=http://localhost:3000

# Optional comma-separated allowlist of emails that may receive sign-in links.
# Leave empty to rely on Supabase Auth settings.
AUTH_ALLOWED_EMAILS=

# --- Outreach (each feature stays off until its keys are set) ---
# Email via Resend (verify your sending domain in Resend first).
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Signs public links (unsubscribe, shared properties) and salts form IP hashes. Required for email,
# property sharing and lead forms. At least 32 random characters: openssl rand -hex 32
UNSUBSCRIBE_SECRET=
# SMS via Twilio. Each workspace sets its own number in Settings → Sending.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Scheduled sequence runner (Vercel Cron sends it as a bearer token). At least 32 characters.
CRON_SECRET=
# AI lead assessment.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Later phases (not read by the app yet; see docs/PLAN.md) ---
# GHL_CLIENT_ID=                # Phase 6: GoHighLevel marketplace app (OAuth)
# GHL_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=             # Phase 6: Google Calendar
# GOOGLE_CLIENT_SECRET=
# CREDENTIALS_ENCRYPTION_KEY=   # Phase 6: encrypts stored OAuth tokens (32 bytes, base64)
# STRIPE_SECRET_KEY=            # Phase 7: billing
# STRIPE_WEBHOOK_SECRET=
