# Copy to .env.local for development. Never commit real values.
# In production, set these in Vercel → Project → Settings → Environment Variables.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# The anon/publishable key is safe in the browser: every table is protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Used only to look up and invite users (Settings → Team).
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of this app (used in sign-in and invite links).
APP_URL=http://localhost:3000

# Optional comma-separated allowlist of emails that may receive sign-in links.
# Leave empty to rely on Supabase Auth settings.
AUTH_ALLOWED_EMAILS=

# --- Later phases (not read by the app yet; see docs/PLAN.md) ---
# ANTHROPIC_API_KEY=            # Phase 4: qualification, summaries, drafting
# TWILIO_ACCOUNT_SID=           # Phase 4: SMS (and Phase 6 voice)
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=
# RESEND_API_KEY=               # Phase 4: email
# RESEND_WEBHOOK_SECRET=
# JOBS_HMAC_SECRET=             # Phase 5: signs scheduled job calls
# GHL_CLIENT_ID=                # Phase 6: GoHighLevel marketplace app (OAuth)
# GHL_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=             # Phase 6: Google Calendar
# GOOGLE_CLIENT_SECRET=
# CREDENTIALS_ENCRYPTION_KEY=   # Phase 6: encrypts stored OAuth tokens (32 bytes, base64)
# STRIPE_SECRET_KEY=            # Phase 7: billing
# STRIPE_WEBHOOK_SECRET=
