# Supabase project (Settings > API). Without these the studio runs in demo
# mode on the seed fixture, which is only allowed outside production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Allow demo mode in a production build (for previews only).
GBS_DEMO_MODE=

# Chromium for server-side PDF export. Leave empty to use Playwright's own
# browser (npx playwright install chromium).
PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# Where the PDF renderer reaches this server, if not the request origin
# (for example behind a proxy): http://127.0.0.1:3000
PDF_RENDER_ORIGIN=
