# Studio sign-in. Everyone on the team uses this password. Required in
# production; in development, leaving it empty lets any password in.
STUDIO_PASSWORD=
# Signs session cookies. Required in production: a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Claude: reading figures from screenshots and writing the report text.
# Optional; without it those features are switched off.
ANTHROPIC_API_KEY=

# The address used in client share links, e.g. https://reports.getbeeseen.com
# (defaults to the address the studio is opened on).
PUBLIC_URL=

# Where clients and reports are stored (one JSON file). Default: ./data
DATA_DIR=

# Chromium for server-side PDF export. Leave empty to use Playwright's own
# browser (npx playwright install chromium).
PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# Where the PDF renderer reaches this server, if not the request origin
# (for example behind a proxy): http://127.0.0.1:3000
PDF_RENDER_ORIGIN=
